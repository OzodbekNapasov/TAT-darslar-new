              </div>
            </div>

            <div style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:0.5rem;">
              <button onclick="insertSampleText('Bemor: Aliyev Vali ')" style="background:#1e293b; color:#fff; border:1px solid #475569; padding:0.4rem 0.75rem; border-radius:6px; font-size:0.8rem; cursor:pointer;">
                + Bemor F.I.SH
              </button>
              <button onclick="insertSampleNumber('120/80 ')" style="background:#064e3b; color:#6ee7b7; border:1px solid #059669; padding:0.4rem 0.75rem; border-radius:6px; font-size:0.8rem; cursor:pointer;">
                + 120/80 (Bosim)
              </button>
              <button onclick="insertSampleNumber('74 ur/daq ')" style="background:#064e3b; color:#6ee7b7; border:1px solid #059669; padding:0.4rem 0.75rem; border-radius:6px; font-size:0.8rem; cursor:pointer;">
                + 74 (Puls)
              </button>
              <button onclick="insertSampleNumber('36.6 C ')" style="background:#064e3b; color:#6ee7b7; border:1px solid #059669; padding:0.4rem 0.75rem; border-radius:6px; font-size:0.8rem; cursor:pointer;">
                + 36.6 °C (Harorat)
              </button>
              <button onclick="clearSampleText()" style="background:#7f1d1d; color:#fca5a5; border:1px solid #991b1b; padding:0.4rem 0.75rem; border-radius:6px; font-size:0.8rem; cursor:pointer;">
                Tozalash
              </button>
            </div>

            <div id="screen-display" class="screen-output">
