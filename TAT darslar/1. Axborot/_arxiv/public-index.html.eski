        <!-- 6. Virtual Nurse Desk Simulator -->
        <div class="card">
          <h2 class="card-title">
            <span>💉</span> 6. Hamshira Ish Stoli va Bemor Ko'rsatkichlarini Kiritish
          </h2>
          <p class="card-subtitle">
            Elektron jurnalga vital ko'rsatkichlarni tezkor kiritish simulyatori:
          </p>

          <div class="grid-2">
            <!-- Form -->
            <form onsubmit="handlePatientSubmit(event)" style="display:flex; flex-direction:column; gap:0.9rem;">
              <div>
                <label style="display:block; font-size:0.85rem; font-weight:700; color:#334155; margin-bottom:0.25rem;">
                  Bemor Familiyasi va Ismi:
                </label>
                <input id="inp-patient" type="text" value="Karimov Anvar Saidovich" required style="width:100%; padding:0.65rem 0.85rem; border-radius:8px; border:1.5px solid #cbd5e1; font-size:0.95rem;">
              </div>

              <div class="grid-3" style="gap:0.5rem;">
                <div>
                  <label style="display:block; font-size:0.75rem; font-weight:700; color:#334155; margin-bottom:0.25rem;">
                    Qon Bosimi:
                  </label>
                  <input id="inp-bp" type="text" value="120/80" required style="width:100%; padding:0.6rem 0.75rem; border-radius:8px; border:1.5px solid #cbd5e1; font-size:0.9rem; font-family:monospace; font-weight:700;">
                </div>
                <div>
                  <label style="display:block; font-size:0.75rem; font-weight:700; color:#334155; margin-bottom:0.25rem;">
                    Puls (ur/daq):
                  </label>
                  <input id="inp-pulse" type="text" value="74" required style="width:100%; padding:0.6rem 0.75rem; border-radius:8px; border:1.5px solid #cbd5e1; font-size:0.9rem; font-family:monospace; font-weight:700;">
                </div>
                <div>
                  <label style="display:block; font-size:0.75rem; font-weight:700; color:#334155; margin-bottom:0.25rem;">
                    Harorat (°C):
                  </label>
                  <input id="inp-temp" type="text" value="36.6" required style="width:100%; padding:0.6rem 0.75rem; border-radius:8px; border:1.5px solid #cbd5e1; font-size:0.9rem; font-family:monospace; font-weight:700;">
                </div>
              </div>

              <div style="display:flex; align-items:center; gap:0.5rem;">
                <input type="checkbox" id="inp-med-given" checked style="width:18px; height:18px; cursor:pointer;">
                <label for="inp-med-given" style="font-size:0.875rem; font-weight:700; color:#1e293b; cursor:pointer;">
                  Dori berildi (Sichqoncha chap tugmasi bilan belgilang)
                </label>
              </div>

              <button type="submit" class="btn-primary" style="align-self:flex-start;">
                💾 EMR Bazaga Saqlash
              </button>

              <div id="patient-save-msg" style="display:none; padding:0.75rem 1rem; border-radius:8px; background:#ecfdf5; border:1px solid #10b981; color:#065f46; font-weight:700; font-size:0.85rem;">
                ✅ Ko'rsatkichlar markaziy bazaga muvaffaqiyatli saqlandi!
              </div>
            </form>

            <!-- Live Database Log -->
            <div style="background:#0f172a; border-radius:12px; padding:1rem; color:#e2e8f0; font-family:monospace; font-size:0.8rem; display:flex; flex-direction:column; justify-content:space-between;">
              <div>
                <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #334155; padding-bottom:0.5rem; margin-bottom:0.75rem;">
                  <span style="color:#60a5fa; font-weight:bold;">TIZIM JURNALI (EMR BAZA)</span>
                  <span style="background:#064e3b; color:#6ee7b7; padding:0.15rem 0.45rem; border-radius:4px; font-size:0.7rem;">JONLI</span>
                </div>
                <div id="sim-log-list" style="display:flex; flex-direction:column; gap:0.5rem;">
                  <div style="background:#1e293b; padding:0.5rem 0.75rem; border-radius:6px; border:1px solid #334155; color:#34d399;">
                    [08:30] Karimov Anvar Saidovich: Qon bosimi: 120/80 mm.sim.ust, Puls: 74 ur/daq, Harorat: 36.6°C. Tizimga dastlabki qabul kiritildi.
                  </div>
                </div>
              </div>
              <div style="color:#64748b; font-size:0.7rem; border-top:1px solid #1e293b; padding-top:0.5rem; margin-top:0.75rem;">
