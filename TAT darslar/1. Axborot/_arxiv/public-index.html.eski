      <!-- ========================================================================= -->
      <!-- TAB 3: BILIMNI SINASH (7 COMPREHENSIVE CLINICAL IT QUESTIONS)             -->
      <!-- ========================================================================= -->
      <div id="pane-quiz" class="tab-pane">
        
        <div class="card">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
            <div>
              <h2 class="card-title">
                <span>📝</span> 1-Dars: Bilimni Sinash Testi
              </h2>
              <p class="card-subtitle" style="margin-bottom:0;">
                Savollarga javob bering, tizim to'g'ri javobni va uning izohini darhol ko'rsatadi (7 ta savol)
              </p>
            </div>
            <div id="score-badge" style="background:#1e40af; color:#ffffff; padding:0.45rem 1.25rem; border-radius:9999px; font-weight:800; font-size:0.9rem;">
              Natija: 0 / 7
            </div>
          </div>

          <!-- Question 1 -->
          <div class="quiz-card" id="q-card-1">
            <h4 style="font-size:1rem; font-weight:800; margin-bottom:0.75rem; color:#0f172a;">
              1. Bemor qon bosimi 120/80 mm sim. ust. va tana harorati 36.6°C ekanligi haqidagi ma'lumot tibbiyotda qaysi axborot turiga kiradi?
            </h4>
            <div class="quiz-option" onclick="handleQuizAnswer(1, 0)">
              <span>A) Raqamli axborot</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(1, 1)">
              <span>B) Ovozli axborot</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(1, 2)">
              <span>C) Grafik axborot</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(1, 3)">
              <span>D) Faqat tasviriy axborot</span>
              <span class="opt-icon"></span>
            </div>
            <div id="exp-1" class="explanation-box"></div>
          </div>

          <!-- Question 2 -->
          <div class="quiz-card" id="q-card-2">
            <h4 style="font-size:1rem; font-weight:800; margin-bottom:0.75rem; color:#0f172a;">
              2. Hamshira shifokor tomonidan bemorga buyurilgan dori dozasini (masalan, 5 mg o'rniga 50 mg emas) xatosiz kiritishi axborotning qaysi muhim xususiyatiga misol bo'ladi?
            </h4>
            <div class="quiz-option" onclick="handleQuizAnswer(2, 0)">
              <span>A) Axborotning ochiqligi</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(2, 1)">
              <span>B) Axborotning aniqligi va to'g'riligi</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(2, 2)">
              <span>C) Axborotning faqat og'zaki bo'lishi</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(2, 3)">
              <span>D) Axborotning qimmatligi</span>
              <span class="opt-icon"></span>
            </div>
            <div id="exp-2" class="explanation-box"></div>
          </div>

          <!-- Question 3 -->
          <div class="quiz-card" id="q-card-3">
            <h4 style="font-size:1rem; font-weight:800; margin-bottom:0.75rem; color:#0f172a;">
              3. Navbatchi hamshira kompyuterdagi bemorlar ro'yxatidan kerakli bemor ismini tanlash uchun sichqonchaning qaysi amalini bajarishi lozim?
            </h4>
            <div class="quiz-option" onclick="handleQuizAnswer(3, 0)">
              <span>A) Sichqonchaning chap tugmasini bir marta bosish (Tanlash)</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(3, 1)">
              <span>B) Sichqonchaning o'ng tugmasini ketma-ket uch marta bosish</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(3, 2)">
              <span>C) Faqat kompyuter quvvat tugmasini bosish</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(3, 3)">
              <span>D) Klaviaturadagi probel tugmasini bosib turish</span>
              <span class="opt-icon"></span>
            </div>
            <div id="exp-3" class="explanation-box"></div>
          </div>

          <!-- Question 4 -->
          <div class="quiz-card" id="q-card-4">
            <h4 style="font-size:1rem; font-weight:800; margin-bottom:0.75rem; color:#0f172a;">
              4. Bemorning tana harorati (masalan, 37.8) yoki qon bosimini tizimga tezkor kiritish uchun klaviaturaning qaysi qismidan foydalanish eng qulay hisoblanadi?
            </h4>
            <div class="quiz-option" onclick="handleQuizAnswer(4, 0)">
              <span>A) Faqat yuqori funksional tugmalar</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(4, 1)">
              <span>B) Klaviaturaning o'ng tarafidagi raqamli blok (Numpad / Raqamlar maydoni)</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(4, 2)">
              <span>C) Faqat katta harflar tugmasi</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(4, 3)">
              <span>D) Sichqoncha g'ildirakchasi</span>
              <span class="opt-icon"></span>
            </div>
            <div id="exp-4" class="explanation-box"></div>
          </div>

          <!-- Question 5 -->
          <div class="quiz-card" id="q-card-5">
            <h4 style="font-size:1rem; font-weight:800; margin-bottom:0.75rem; color:#0f172a;">
              5. Ish kuni yakunida bemorlar ma'lumotlar bazasi shikastlanmasligi va xavfsiz saqlanishi uchun kompyuter qanday o'chirilishi kerak?
            </h4>
            <div class="quiz-option" onclick="handleQuizAnswer(5, 0)">
              <span>A) Kompyuter elektr vilkasini darhol rozetkadan uzib qo'yish</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(5, 1)">
              <span>B) Barcha kiritilgan ma'lumotlarni saqlab, dasturlardan chiqib, 'Boshlash' menyusi orqali tizimni xavfsiz o'chirish</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(5, 2)">
              <span>C) Faqatgina monitorni o'chirib, asosiy blokni yoqiq qoldirish</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(5, 3)">
              <span>D) Kompyuter quvvat tugmasini 10 soniya bosib ushlab turish</span>
              <span class="opt-icon"></span>
            </div>
            <div id="exp-5" class="explanation-box"></div>
          </div>

          <!-- Question 6 -->
          <div class="quiz-card" id="q-card-6">
            <h4 style="font-size:1rem; font-weight:800; margin-bottom:0.75rem; color:#0f172a;">
              6. Elektrokardiogramma egri chiziqlari, rentgen va ultratovush (UTT) tasvirlari tibbiyotda axborotning qaysi turiga kiradi?
            </h4>
            <div class="quiz-option" onclick="handleQuizAnswer(6, 0)">
              <span>A) Grafik va tasviriy axborot</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(6, 1)">
              <span>B) Faqat matnli axborot</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(6, 2)">
              <span>C) Ovozli nutq axboroti</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(6, 3)">
              <span>D) Faqat shifrlangan kod</span>
              <span class="opt-icon"></span>
            </div>
            <div id="exp-6" class="explanation-box"></div>
          </div>

          <!-- Question 7 -->
          <div class="quiz-card" id="q-card-7">
            <h4 style="font-size:1rem; font-weight:800; margin-bottom:0.75rem; color:#0f172a;">
              7. Bemorning kasallik tarixi va shaxsiy ma'lumotlarini ruxsatsiz begona kishilarga oshkor qilmaslik axborotning qaysi tamoyiliga to'g'ri keladi?
            </h4>
            <div class="quiz-option" onclick="handleQuizAnswer(7, 0)">
              <span>A) Axborot maxfiyligi va hamshiralik siri</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(7, 1)">
              <span>B) Axborotning ommaviyligi</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(7, 2)">
              <span>C) Axborotning bepul tarqatilishi</span>
              <span class="opt-icon"></span>
            </div>
            <div class="quiz-option" onclick="handleQuizAnswer(7, 3)">
              <span>D) Axborotning doimiy o'zgaruvchanligi</span>
              <span class="opt-icon"></span>
            </div>
            <div id="exp-7" class="explanation-box"></div>
          </div>

          <!-- Certificate Result Box -->
          <div id="cert-box" style="display:none; background:linear-gradient(135deg, #1e40af, #0f172a); color:#ffffff; padding:2.5rem 1.5rem; border-radius:20px; text-align:center; border:2px solid #60a5fa; margin-top:2rem; box-shadow:0 10px 25px rgba(30,64,175,0.3);">
            <div style="font-size:3rem; margin-bottom:0.5rem;">🎓</div>
            <span style="font-size:0.75rem; font-weight:900; background:#3b82f6; color:#ffffff; padding:0.3rem 0.8rem; border-radius:9999px; text-transform:uppercase; letter-spacing:0.05em; display:inline-block; margin-bottom:0.75rem;">
