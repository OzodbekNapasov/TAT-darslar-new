      <!-- ========================================================================= -->
      <!-- TAB 1: NAZARIYA (MEDICAL INFORMATION & 7 FORMS)                           -->
      <!-- ========================================================================= -->
      <div id="pane-theory" class="tab-pane">
        
        <!-- Top Theory Hero -->
        <div class="hero-banner">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem; flex-wrap:wrap; gap:0.5rem;">
            <span style="font-size:0.75rem; font-weight:900; background:rgba(255,255,255,0.2); padding:0.25rem 0.65rem; border-radius:6px; text-transform:uppercase;">
              1-Dars Nazariyasi
            </span>
            <span style="font-size:0.85rem; color:#bfdbfe; font-weight:700;">
              Shahrisabz Tibbiyot Texnikumi
            </span>
          </div>
          <h2 style="font-size:1.5rem; font-weight:900; line-height:1.25; margin-bottom:0.5rem;">
            Mavzu: Axborot haqida tushuncha. Axborot texnologiyalari haqida ma’lumot.
          </h2>
          <p style="font-size:0.95rem; color:#dbeafe; line-height:1.5;">
            Tibbiyot sohasida axborot tushunchasi, uning 5 ta asosiy xususiyati, 7 ta taqdim etilish shakli hamda zamonaviy hamshira faoliyatida tibbiy axborot texnologiyalarining o'rni.
          </p>
        </div>

        <!-- Card: What is Medical Info -->
        <div class="card">
          <h2 class="card-title">
            <span>💡</span> Tibbiy axborot nima?
          </h2>
          <p style="font-size:0.95rem; color:#334155; line-height:1.6; margin-bottom:1.5rem;">
            Tibbiyotda axborot — bu bemorning holati, shikoyati, tahlil natijalari va davolash jarayoni haqidagi ma'lumotlar majmuidir. Masalan, hamshira bemorning tana haroratini o'lchaganda olingan <strong style="color:#0f172a;">38.5°C</strong> ko'rsatkichi — bu xom ma'lumot. Ushbu ma'lumotni <em>"Isitma baland, shifokorga xabar berish kerak"</em> deb baholash esa <strong style="color:#2563eb;">axborot</strong> hisoblanadi.
          </p>

          <h3 style="font-size:1.15rem; font-weight:900; color:#0f172a; margin-bottom:1rem;">
            Tibbiyotda axborotning 7 ta asosiy taqdim etilish shakli:
          </h3>

          <div class="grid-3" style="margin-bottom:1.5rem;">
            <!-- 1. Matnli -->
            <div class="type-card">
              <div>
                <div class="type-card-header">
                  <div class="type-card-icon">📄</div>
                  <h4>1. Matnli axborot</h4>
                </div>
                <p>Bemorning shikoyatlari, anamnez (kasallik tarixi), shifokor kundaligi, epikriz va hamshiralik parvarish rejasi.</p>
              </div>
              <div class="example">Misol: "Bemor bosh og'rig'idan shikoyat qilmoqda"</div>
            </div>

            <!-- 2. Raqamli -->
            <div class="type-card">
              <div>
                <div class="type-card-header">
                  <div class="type-card-icon">🔢</div>
                  <h4>2. Raqamli axborot</h4>
                </div>
                <p>Qon bosimi (120/80 mm sim.ust), puls (74 ur/daq), harorat (36.6°C), glyukoza (5.2 mmol/l), gemoglobin.</p>
              </div>
              <div class="example">Misol: 120/80 mm sim.ust, 37.2°C, 5.5 mmol/l</div>
            </div>

            <!-- 3. Grafik va Tasviriy -->
            <div class="type-card">
              <div>
                <div class="type-card-header">
                  <div class="type-card-icon">📈</div>
                  <h4>3. Grafik & Tasviriy</h4>
                </div>
                <p>Rentgen suratlari, MRT, MSKT (tomografiya), ultratovush (UTT/UZI) va elektrokardiogramma (EKG) to'lqinlari.</p>
              </div>
              <div class="example">Misol: Rentgen plyonkasi, EKG qog'oz tasmasi</div>
            </div>

            <!-- 4. Tovushli (Audio) -->
            <div class="type-card">
              <div>
                <div class="type-card-header">
                  <div class="type-card-icon">🔊</div>
                  <h4>4. Tovushli (Audio)</h4>
                </div>
                <p>Fonendoskop orqali yurak tonlari va nafas shovqinlarini eshitish (auskultatsiya), audiometriya signallari.</p>
              </div>
              <div class="example">Misol: Yurak urish tovushlari, o'pka xirillashi</div>
            </div>

            <!-- 5. Video va Dinamik -->
            <div class="type-card">
              <div>
                <div class="type-card-header">
                  <div class="type-card-icon">🎥</div>
                  <h4>5. Video & Dinamik</h4>
                </div>
                <p>Endoskopiya, gastroskopiya, laparoskopik video-jarrohlik jarayoni hamda exokardiografiya videolari.</p>
              </div>
              <div class="example">Misol: Laparoskopik operatsiya video yozuvi</div>
            </div>

            <!-- 6. Taktil (Sezgi) -->
            <div class="type-card">
              <div>
                <div class="type-card-header">
                  <div class="type-card-icon">✋</div>
                  <h4>6. Taktil (Sezgi)</h4>
                </div>
                <p>Qo'l bilan paypaslab tekshirish (palpatsiya), terining harorati, elastikligi, shishlar va bionik sensorlar.</p>
              </div>
              <div class="example">Misol: Qorin palpatsiyasi, terining tarangligi</div>
            </div>
          </div>

          <!-- 7. Bio-kodli (Full width) -->
          <div style="background:#f8fafc; border:2px solid #e2e8f0; border-radius:14px; padding:1.25rem; display:flex; align-items:flex-start; gap:1rem; margin-bottom:1.5rem;">
            <div style="width:44px; height:44px; border-radius:10px; background:#ffe4e6; color:#e11d48; display:flex; align-items:center; justify-content:center; font-size:1.25rem; font-weight:800; flex-shrink:0;">
              🧬
            </div>
            <div>
              <h4 style="font-size:1.05rem; font-weight:800; color:#1e293b; margin-bottom:0.25rem;">
                7. Maxsus Bio-kodli va Identifikatsiya axboroti
              </h4>
              <p style="font-size:0.875rem; color:#475569; line-height:1.5;">
                Bemor bilaguzugidagi QR va Shtrix-kodlar (shaxsni xatosiz aniqlash), DNK va genetik kod sekvensiyasi, dori vositalarining raqamli markirovkasi hamda shifrlangan elektron retsept kodlari.
              </p>
            </div>
          </div>

          <!-- Senses Breakdown -->
          <div style="background:linear-gradient(135deg, #1e3a8a, #0f172a); color:#ffffff; padding:1.5rem; border-radius:16px;">
            <h4 style="font-size:1rem; font-weight:800; margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem;">
              <span>👁️</span> Inson idrok a'zolari bo'yicha axborot qabul qilish ulushlari:
            </h4>

            <div class="grid-4" style="text-align:center; gap:0.75rem;">
              <div style="background:rgba(255,255,255,0.1); padding:0.75rem; border-radius:10px;">
                <strong style="font-size:1.35rem; color:#93c5fd; display:block;">80% - 90%</strong>
                <span style="font-size:0.8rem; font-weight:700;">Vizual (Ko'rish)</span>
                <p style="font-size:0.7rem; color:#cbd5e1; margin-top:2px;">Ko'z orqali</p>
              </div>
              <div style="background:rgba(255,255,255,0.1); padding:0.75rem; border-radius:10px;">
                <strong style="font-size:1.35rem; color:#5eead4; display:block;">8% - 10%</strong>
                <span style="font-size:0.8rem; font-weight:700;">Audial (Eshitish)</span>
                <p style="font-size:0.7rem; color:#cbd5e1; margin-top:2px;">Quloq orqali</p>
              </div>
              <div style="background:rgba(255,255,255,0.1); padding:0.75rem; border-radius:10px;">
                <strong style="font-size:1.35rem; color:#c084fc; display:block;">1% - 2%</strong>
                <span style="font-size:0.8rem; font-weight:700;">Taktil (Sezish)</span>
                <p style="font-size:0.7rem; color:#cbd5e1; margin-top:2px;">Teri orqali</p>
              </div>
              <div style="background:rgba(255,255,255,0.1); padding:0.75rem; border-radius:10px;">
                <strong style="font-size:1.35rem; color:#fde047; display:block;">~1%</strong>
                <span style="font-size:0.8rem; font-weight:700;">Hid va Ta'm</span>
                <p style="font-size:0.7rem; color:#cbd5e1; margin-top:2px;">Burun va til</p>
              </div>
            </div>
          </div>
        </div>

        <!-- 5 Essential Properties -->
        <div class="card">
          <h2 class="card-title">
            <span>🛡️</span> Hamshiralik amaliyotida axborotning 5 ta asosiy xususiyati
          </h2>
          <p class="card-subtitle">
            Tibbiy ma'lumotlar bilan ishlashda har bir hamshira qat'iy amal qilishi shart bo'lgan talablar:
          </p>

          <div class="prop-item">
            <div class="prop-num">1</div>
            <div class="prop-text">
              <h4>Aniqlik (To'g'rilik)</h4>
              <p>Dori dozasini xatosiz yozish: masalan, <strong>50 mg emas</strong>, shifokor buyurgan aniq <strong>5 mg</strong> miqdorini kiritish.</p>
            </div>
          </div>

          <div class="prop-item">
            <div class="prop-num">2</div>
            <div class="prop-text">
              <h4>O'z vaqtidalik (Tezkorlik)</h4>
              <p>Shoshilinch qon tahlillari va keskin ko'tarilgan qon bosimini shifokorga darhol yetkazish.</p>
            </div>
          </div>

          <div class="prop-item">
            <div class="prop-num">3</div>
            <div class="prop-text">
              <h4>To'liqlik</h4>
              <p>Bemorning barcha shikoyatlari, avvalgi operatsiyalari va dorilarga allergik reaksiyalarini to'liq qayd etish.</p>
            </div>
          </div>

          <div class="prop-item">
            <div class="prop-num">4</div>
            <div class="prop-text">
              <h4>Ishonchlilik</h4>
              <p>Faqat tekshirilgan va to'g'ri sozlangan tibbiy asboblar (bosim o'lchagich, kardiograf, analizator) ma'lumotlariga tayanish.</p>
            </div>
          </div>

          <div class="prop-item">
            <div class="prop-num">5</div>
            <div class="prop-text">
              <h4>Maxfiylik (Tibbiy sir)</h4>
              <p>Bemorning tashxisi va davolash ma'lumotlarini begonalar yoki ruxsatsiz shaxslarga aslo oshkor qilmaslik.</p>
            </div>
          </div>
        </div>

        <!-- Action Nav -->
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <button class="btn-secondary" onclick="switchTab('intro')">
            ← Kirish qismiga qaytish
          </button>
          <button class="btn-primary" onclick="switchTab('practice')">
