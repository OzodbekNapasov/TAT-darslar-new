      <!-- ================= BOTTOM METHODOLOGY & GLOSSARY ================= -->
      <section style="margin-top:2rem; padding-top:2rem; border-top:2px solid #e2e8f0;">
        <div class="grid-3">
          
          <!-- Metodik tavsiya -->
          <div style="background:#0f766e; color:#ffffff; border-radius:16px; padding:1.5rem; display:flex; flex-direction:column; justify-content:space-between;">
            <div>
              <h3 style="font-size:1.1rem; font-weight:900; margin-bottom:0.5rem; display:flex; align-items:center; gap:0.4rem;">
                <span>💡</span> Metodik tavsiya
              </h3>
              <p style="font-size:0.875rem; color:#ccfbf1; line-height:1.5; margin-bottom:1rem;">
                Hurmatli talaba! Tibbiyotda IT — bu bemor hayotini asrashda tezkor va to'g'ri qaror qabul qilish vositasidir. Avval kirish va nazariyani o'zlashtiring, so'ng amaliyot va testga o'ting.
              </p>
            </div>
            <button id="btn-bottom-next" onclick="handleBottomNext()" style="background:#ffffff; color:#0f766e; border:none; padding:0.6rem 1rem; border-radius:10px; font-weight:800; font-size:0.85rem; cursor:pointer; align-self:flex-start;">
              Nazariyani boshlash →
            </button>
          </div>

          <!-- Glossariy -->
          <div class="card" style="margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between;">
            <div>
              <h3 style="font-size:0.9rem; font-weight:900; text-transform:uppercase; color:#0f172a; margin-bottom:0.75rem; display:flex; align-items:center; gap:0.4rem;">
                <span>📖</span> Muhim IT-Tibbiyot Atamalari
              </h3>

              <div style="display:flex; flex-direction:column; gap:0.6rem;">
                <div style="border-left:3px solid #2563eb; padding-left:0.6rem;">
                  <strong style="font-size:0.85rem; color:#0f172a; display:block;">Elektron tibbiy karta (EMR):</strong>
                  <span style="font-size:0.75rem; color:#64748b;">Bemorning kasallik tarixi va tahlillarining raqamli pasporti.</span>
                </div>
                <div style="border-left:3px solid #0d9488; padding-left:0.6rem;">
                  <strong style="font-size:0.85rem; color:#0f172a; display:block;">Kasalxona axborot tizimi:</strong>
                  <span style="font-size:0.75rem; color:#64748b;">Qabul, bo'limlar va laboratoriyani birlashtiruvchi dastur.</span>
                </div>
                <div style="border-left:3px solid #7e22ce; padding-left:0.6rem;">
                  <strong style="font-size:0.85rem; color:#0f172a; display:block;">Raqamli blok (Numpad):</strong>
                  <span style="font-size:0.75rem; color:#64748b;">Bosim, puls va haroratni bir qo'lda tez kiritish maydoni.</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Progress bar -->
          <div class="card" style="margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between;">
            <div>
              <h3 style="font-size:0.9rem; font-weight:900; text-transform:uppercase; color:#0f172a; margin-bottom:0.75rem; display:flex; align-items:center; gap:0.4rem;">
                <span>🏆</span> Darsdagi Faollik Ko'rsatkichi
              </h3>

              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
                <span style="font-size:0.75rem; font-weight:800; color:#64748b; text-transform:uppercase;">O'zlashtirish:</span>
                <span id="progress-percent" style="font-size:1rem; font-weight:900; color:#2563eb;">25%</span>
              </div>

              <div style="height:10px; background:#e2e8f0; border-radius:9999px; overflow:hidden; margin-bottom:0.75rem;">
                <div id="progress-bar-fill" style="width:25%; height:100%; background:#2563eb; transition:width 0.3s ease;"></div>
              </div>

              <p id="progress-status-desc" style="font-size:0.8rem; color:#475569; line-height:1.4;">
                Siz hozir kirish bo'limini o'rganmoqdasiz.
              </p>
            </div>

            <div style="padding-top:0.75rem; border-top:1px solid #e2e8f0; display:flex; justify-content:space-between; font-size:0.75rem; font-weight:800; color:#64748b;">
              <span>Mavzu: 1-Dars</span>
              <span style="color:#2563eb;">Hamshiralik ishi</span>
            </div>
          </div>

        </div>
      </section>

    </div>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer>
    <div class="container">
      <div class="footer-inner">
        <div>
          <strong style="color:#0f172a;">Shahrisabz Tibbiyot Texnikumi</strong> — Tibbiyotda axborot texnologiyalari kafedrasi
          <div style="font-size:0.75rem; color:#94a3b8; margin-top:2px;">
            1-Dars: Hamshiralik ishi va kompyuter savodxonligi (100% Offline versiya)
          </div>
        </div>
        <div style="font-size:0.8rem; font-weight:700; color:#2563eb;">
          © 2026 Shahrisabz Tibbiyot Texnikumi
        </div>
      </div>
    </div>
  </footer>

  <!-- ================= OFFLINE JAVASCRIPT LOGIC ================= -->
  <script>
    // Current Active Tab
    let activeTab = 'intro';

    // Formatted Date in Uzbek
    function updateUzbekDate() {
      const now = new Date();
      const day = now.getDate();
      const monthsUz = [
        'yanvar', 'fevral', 'mart', 'aprel', 'may', 'iyun',
        'iyul', 'avgust', 'sentyabr', 'oktyabr', 'noyabr', 'dekabr'
      ];
      const weekdaysUz = [
        'Yakshanba', 'Dushanba', 'Seshanba', 'Chorshanba', 'Payshanba', 'Juma', 'Shanba'
      ];
      const monthName = monthsUz[now.getMonth()];
      const year = now.getFullYear();
      const weekday = weekdaysUz[now.getDay()];
      const fullDateStr = `${year}-yil ${day}-${monthName}, ${weekday}`;
      
      const dateEl = document.getElementById('current-date-text');
      if (dateEl) dateEl.innerText = fullDateStr;
    }

    // Switch Tab
    function switchTab(tabId) {
      activeTab = tabId;
      document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));

      const targetPane = document.getElementById('pane-' + tabId);
      const targetBtn = document.getElementById('nav-btn-' + tabId);
      
      if (targetPane) targetPane.classList.add('active');
      if (targetBtn) targetBtn.classList.add('active');

      updateBottomNextButton();
      updateProgress();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Update bottom methodology action button
    function updateBottomNextButton() {
      const btn = document.getElementById('btn-bottom-next');
      if (!btn) return;
      if (activeTab === 'intro') btn.innerText = "Nazariyani boshlash →";
      else if (activeTab === 'theory') btn.innerText = "Amaliyotga o'tish →";
      else if (activeTab === 'practice') btn.innerText = "Testni topshirish →";
      else btn.innerText = "Kirish qismiga o'tish →";
    }

    function handleBottomNext() {
      if (activeTab === 'intro') switchTab('theory');
      else if (activeTab === 'theory') switchTab('practice');
      else if (activeTab === 'practice') switchTab('quiz');
      else switchTab('intro');
    }

    // Interactive Intro Comparison Mode
    function setCompareMode(mode) {
      const digitalBtn = document.getElementById('btn-comp-digital');
      const paperBtn = document.getElementById('btn-comp-paper');
      const digitalBox = document.getElementById('compare-digital-box');
      const paperBox = document.getElementById('compare-paper-box');

      if (mode === 'digital') {
        digitalBtn.className = 'compare-btn active-digital';
        paperBtn.className = 'compare-btn';
        digitalBox.style.display = 'block';
        paperBox.style.display = 'none';
      } else {
        digitalBtn.className = 'compare-btn';
        paperBtn.className = 'compare-btn active-paper';
        digitalBox.style.display = 'none';
        paperBox.style.display = 'block';
      }
    }

    // Mouse Interactive Diagram Logic
    function selectMousePart(part) {
      const svgBody = document.getElementById('svg-mouse-body');
      const svgLeft = document.getElementById('svg-mouse-left');
      const svgRight = document.getElementById('svg-mouse-right');
      const svgWheel = document.getElementById('svg-mouse-wheel');

      const btnLeft = document.getElementById('btn-mouse-left');
      const btnRight = document.getElementById('btn-mouse-right');
      const btnWheel = document.getElementById('btn-mouse-wheel');

      const titleEl = document.getElementById('mouse-detail-title');
      const descEl = document.getElementById('mouse-detail-desc');

      // Reset SVGs
      svgBody.setAttribute('fill', '#f8fafc');
      svgBody.setAttribute('stroke', '#94a3b8');
      svgLeft.setAttribute('fill', '#cbd5e1');
      svgRight.setAttribute('fill', '#cbd5e1');
      svgWheel.setAttribute('fill', '#64748b');

      btnLeft.className = 'btn-secondary';
      btnRight.className = 'btn-secondary';
      btnWheel.className = 'btn-secondary';

      if (part === 'left') {
        svgLeft.setAttribute('fill', '#2563eb');
        btnLeft.className = 'btn-primary';
        titleEl.innerText = "Sichqonchaning Chap Tugmasi (Asosiy ishchi tugma)";
        descEl.innerHTML = "<strong>1 marta bosish (Tanlash):</strong> Bemorlar ro'yxatidan kerakli bemorni tanlash, qon guruhi katakchasini belgilash yoki buyruq tugmasini bosish.<br><br><strong>2 marta tez bosish (Ochish):</strong> Bemorning to'liq elektron kasallik tarixi faylini yoki tahlil natijalari varaqasini ochish.";
      } else if (part === 'right') {
        svgRight.setAttribute('fill', '#2563eb');
        btnRight.className = 'btn-primary';
        titleEl.innerText = "Sichqonchaning O'ng Tugmasi (Kontekst menyu)";
        descEl.innerHTML = "Bemor fayli yoki jadval ustiga olib borib o'ng tugma bosilganda qo'shimcha buyruqlar menyusi ochiladi: <strong>\"Tahrirlash\", \"Chop etish\", \"Nusxa olish\", \"Arxivga yuborish\"</strong>.";
      } else if (part === 'wheel') {
        svgWheel.setAttribute('fill', '#e11d48');
        btnWheel.className = 'btn-primary';
        titleEl.innerText = "O'rta G'ildirakcha (Scroll / Aylantirish)";
        descEl.innerHTML = "G'ildirakchani oldinga yoki orqaga aylantirish orqali bemorning ko'p sahifali laboratoriya natijalari, reanimatsiya jurnali yoki kardiogramma tasvirini yuqoriga-pastga tezkor varaqlash mumkin.";
      } else if (part === 'body') {
        svgBody.setAttribute('fill', '#eff6ff');
        svgBody.setAttribute('stroke', '#2563eb');
        titleEl.innerText = "Sichqonchani To'g'ri Ushlash (Ergonomika)";
        descEl.innerHTML = "Sichqonchani butun kaft bilan yumshoq ushlang. Ko'rsatkich barmog'i chap tugmada, o'rta barmoq o'ng tugmada erkin turishi lozim. Bilak egilmasligi navbatchilikda qo'l toliqishining oldini oladi.";
      }
    }

    // Keyboard Zone Selector Logic
    function selectKbZone(zone) {
      const titleEl = document.getElementById('kb-zone-title');
      const descEl = document.getElementById('kb-zone-desc');

      ['numpad', 'alpha', 'special', 'function', 'arrows'].forEach(z => {
        const btn = document.getElementById('btn-kb-' + z);
        if (btn) btn.className = (z === zone) ? 'btn-primary' : 'btn-secondary';
      });

      if (zone === 'numpad') {
        titleEl.innerText = "1. Raqamli blok (Numpad) — Hamshiraning eng asosiy quroli";
        titleEl.style.color = "#0f766e";
        descEl.innerHTML = "Klaviaturaning o'ng tomonidagi kalkulyatorga o'xshash blok. Bemorning qon bosimi (120/80), pulsi (74), harorati (36.6) va dori dozasini bir qo'l bilan 3 barobar tez kiritish imkonini beradi. Yoqish uchun <strong>[Num Lock]</strong> tugmasi bosiladi.";
      } else if (zone === 'alpha') {
        titleEl.innerText = "2. Alifbo-matnli asosiy blok";
        titleEl.style.color = "#1e40af";
        descEl.innerHTML = "Bemorning ism-familiyasi, manzili, shikoyatlari, shifokor tashxislari va dorilar nomlarini to'liq matn ko'rinishida yozish uchun xizmat qiladi. Tilni almashtirish: <strong>Alt + Shift</strong> yoki <strong>Win + Probel</strong>.";
      } else if (zone === 'special') {
        titleEl.innerText = "3. Boshqaruv (Maxsus) tugmalari: Tab, Enter, Ctrl+S, Win+L";
        titleEl.style.color = "#7e22ce";
        descEl.innerHTML = "<strong>Tab ⇥:</strong> Keyingi katakka (qon bosimidan haroratga) sichqonchasiz sakrash.<br><strong>Enter ↵:</strong> Tasdiqlash va yangi qator ochish.<br><strong>Ctrl + S:</strong> Ma'lumotlarni bazaga zudlik bilan saqlash.<br><strong>Win + L:</strong> Palataga chiqishda ekranni tezkor qulflash.";
      } else if (zone === 'function') {
        titleEl.innerText = "4. Funksional tugmalar (F1 - F12)";
        titleEl.style.color = "#b45309";
        descEl.innerHTML = "<strong>F5:</strong> Ekranni yangilash (laboratoriyadan yangi kelgan tahlillarni darhol ko'rish).<br><strong>F1:</strong> Dastur bo'yicha yordam va ma'lumotnoma oynasini ochish.";
      } else if (zone === 'arrows') {
        titleEl.innerText = "5. Navigatsiya va Harakatlanish (Strelka) tugmalari";
        titleEl.style.color = "#4338ca";
        descEl.innerHTML = "Bemorlar ro'yxati va jadval katakchalari bo'ylab yuqoriga (▲), pastga (▼), o'ngga (▶) va chapga (◀) yurish uchun xizmat qiladi. <strong>Page Up</strong> va <strong>Page Down</strong> uzun tibbiy jadvallarni bir sahifadan tez varaqlaydi.";
      }
    }

    // Keyboard LED Indicators Logic
    let isNumLock = true;
    let isCapsLock = false;
    let isScrollLock = false;
    let currentSampleText = "Bemor: Aliyev Vali, Qon bosimi: 120/80, Harorat: 36.6 C";

    function updateLEDs() {
      // NUM
      const lampNum = document.getElementById('lamp-num');
      const tagNum = document.getElementById('tag-num');
      const btnNum = document.getElementById('btn-toggle-num');
      const cardNum = document.getElementById('card-status-num');
      const unitNum = document.getElementById('led-unit-num');

      if (isNumLock) {
        lampNum.classList.add('active');
        unitNum.classList.add('active');
        tagNum.innerText = "YONIQ";
        btnNum.classList.add('active');
        cardNum.innerText = "● Hozir Yoniq";
        cardNum.style.color = "#059669";
      } else {
        lampNum.classList.remove('active');
        unitNum.classList.remove('active');
        tagNum.innerText = "O'CHIQ";
        btnNum.classList.remove('active');
        cardNum.innerText = "○ Hozir O'chiq";
        cardNum.style.color = "#dc2626";
      }

      // CAPS
      const lampCaps = document.getElementById('lamp-caps');
      const tagCaps = document.getElementById('tag-caps');
      const btnCaps = document.getElementById('btn-toggle-caps');
      const cardCaps = document.getElementById('card-status-caps');
      const unitCaps = document.getElementById('led-unit-caps');
      const display = document.getElementById('screen-display');

      if (isCapsLock) {
        lampCaps.classList.add('active');
        unitCaps.classList.add('active');
        tagCaps.innerText = "YONIQ";
        btnCaps.classList.add('active');
        cardCaps.innerText = "● Hozir Yoniq";
        cardCaps.style.color = "#059669";
        display.classList.add('caps-on');
      } else {
        lampCaps.classList.remove('active');
        unitCaps.classList.remove('active');
        tagCaps.innerText = "O'CHIQ";
        btnCaps.classList.remove('active');
        cardCaps.innerText = "○ Hozir O'chiq";
        cardCaps.style.color = "#64748b";
        display.classList.remove('caps-on');
      }

      // SCROLL
      const lampScroll = document.getElementById('lamp-scroll');
      const tagScroll = document.getElementById('tag-scroll');
      const btnScroll = document.getElementById('btn-toggle-scroll');
      const cardScroll = document.getElementById('card-status-scroll');
      const unitScroll = document.getElementById('led-unit-scroll');

      if (isScrollLock) {
        lampScroll.classList.add('active');
        unitScroll.classList.add('active');
        tagScroll.innerText = "YONIQ";
        btnScroll.classList.add('active');
        cardScroll.innerText = "● Hozir Yoniq";
        cardScroll.style.color = "#059669";
      } else {
        lampScroll.classList.remove('active');
        unitScroll.classList.remove('active');
        tagScroll.innerText = "O'CHIQ";
        btnScroll.classList.remove('active');
        cardScroll.innerText = "○ Hozir O'chiq";
        cardScroll.style.color = "#64748b";
      }

      document.getElementById('playground-status-text').innerText = 
        `NUM: ${isNumLock ? 'ON' : 'OFF'} | CAPS: ${isCapsLock ? 'ON' : 'OFF'} | SCROLL: ${isScrollLock ? 'ON' : 'OFF'}`;
    }

    function toggleNumLock() {
      isNumLock = !isNumLock;
      updateLEDs();
    }

    function toggleCapsLock() {
      isCapsLock = !isCapsLock;
      updateLEDs();
    }

    function toggleScrollLock() {
      isScrollLock = !isScrollLock;
      updateLEDs();
    }

    function insertSampleText(txt) {
      currentSampleText += " " + txt;
      document.getElementById('screen-display').innerText = currentSampleText;
    }

    function insertSampleNumber(numStr) {
      if (isNumLock) {
        currentSampleText += " " + numStr;
        document.getElementById('screen-display').innerText = currentSampleText;
      } else {
        alert("⚠️ NUM LOCK o'chiq bo'lgani uchun raqam kiritilmadi! Avval [Num Lock] tugmasini bosing.");
      }
    }

    function clearSampleText() {
      currentSampleText = "";
      document.getElementById('screen-display').innerText = "[Matn kiritilmagan]";
    }

    // Nurse Desk Simulator Logic
    function handlePatientSubmit(e) {
      e.preventDefault();
      const pName = document.getElementById('inp-patient').value;
      const bp = document.getElementById('inp-bp').value;
      const pulse = document.getElementById('inp-pulse').value;
      const temp = document.getElementById('inp-temp').value;
      const medGiven = document.getElementById('inp-med-given').checked;

      const now = new Date();
      const timeStr = now.toLocaleTimeString('uz-UZ', { hour: '2-digit', minute: '2-digit' });

      const logList = document.getElementById('sim-log-list');
      const newEntry = document.createElement('div');
      newEntry.style.background = '#1e293b';
      newEntry.style.padding = '0.5rem 0.75rem';
      newEntry.style.borderRadius = '6px';
      newEntry.style.border = '1px solid #334155';
      newEntry.style.color = '#34d399';
      newEntry.innerText = `[${timeStr}] ${pName}: Qon bosimi: ${bp} mm.sim.ust, Puls: ${pulse} ur/daq, Harorat: ${temp}°C. Muolaja: ${medGiven ? 'Bajarildi (Kiritildi)' : 'Kutilmoqda'}`;

      logList.insertBefore(newEntry, logList.firstChild);

      const msg = document.getElementById('patient-save-msg');
      msg.style.display = 'block';
      setTimeout(() => { msg.style.display = 'none'; }, 3500);
    }

    // ================= QUIZ LOGIC (7 QUESTIONS) =================
    const QUIZ_DATA = [
      {
        id: 1,
        correct: 0, // A
        exp: "To'g'ri! Qon bosimi, puls, tana harorati va laboratoriya tahlil ko'rsatkichlari aniq raqamli o'lchovlar bilan ifodalangani sababli 'Raqamli axborot' turiga kiradi."
      },
      {
        id: 2,
        correct: 1, // B
        exp: "To'g'ri! Dori dozasi yoki bemor tahlil ko'rsatkichlarining xatosiz, to'g'ri qayd etilishi axborotning eng asosiy talabi bo'lgan 'Aniqlik' (to'g'rilik) xususiyatidir."
      },
      {
        id: 3,
        correct: 0, // A
        exp: "To'g'ri! Tizim ro'yxatidan kerakli bemorni yoki buyruq katakchasini tanlash uchun sichqonchaning chap tugmasi bir marta bosiladi."
      },
      {
        id: 4,
        correct: 1, // B
        exp: "To'g'ri! Tibbiyotda raqamli ko'rsatkichlarni bir qo'l bilan tez va xatosiz terish uchun klaviaturaning o'ng qismidagi raqamli blokdan (Numpad) foydalanish eng samarali usuldir."
      },
      {
        id: 5,
        correct: 1, // B
        exp: "To'g'ri! Tizimdagi bemorlar tarixi va laboratoriya ma'lumotlari buzilmasligi uchun barcha oynalar saqlanadi va 'Boshlash -> Tizimni o'chirish' orqali to'g'ri o'chiriladi."
      },
      {
        id: 6,
        correct: 0, // A
        exp: "To'g'ri! Yurak ritmi kardiogrammada grafik shaklda, rentgen va ultratovush apparati natijalari esa tasviriy axborot shaklida namoyon bo'ladi."
      },
      {
        id: 7,
        correct: 0, // A
        exp: "To'g'ri! Bemorning sog'lig'i, tashxisi va davolash rejasiga oid ma'lumotlar qonun bilan himoyalangan 'Tibbiy sir' va maxfiy axborot hisoblanadi."
      }
    ];

    const quizAnswers = {};

    function handleQuizAnswer(qId, selectedOptIdx) {
      if (quizAnswers[qId] !== undefined) return; // already answered

      const qObj = QUIZ_DATA.find(q => q.id === qId);
      if (!qObj) return;

      const isCorrect = selectedOptIdx === qObj.correct;
      quizAnswers[qId] = { selected: selectedOptIdx, isCorrect: isCorrect };

      const card = document.getElementById('q-card-' + qId);
      const options = card.querySelectorAll('.quiz-option');

      options.forEach((opt, idx) => {
        opt.classList.add('disabled');
        if (idx === qObj.correct) {
          opt.classList.add('correct');
        } else if (idx === selectedOptIdx && !isCorrect) {
          opt.classList.add('incorrect');
        } else {
          opt.classList.add('dimmed');
        }
      });

      if (isCorrect) {
        card.classList.add('answered-correct');
      } else {
        card.classList.add('answered-incorrect');
      }

      const expBox = document.getElementById('exp-' + qId);
      expBox.style.display = 'block';
      if (isCorrect) {
        expBox.className = 'explanation-box correct-exp';
        expBox.innerHTML = `<strong>✅ Izoh va xulosa:</strong> ${qObj.exp}`;
      } else {
        expBox.className = 'explanation-box incorrect-exp';
        expBox.innerHTML = `<strong>❌ Xato! To'g'ri javob tushuntirishi:</strong> ${qObj.exp}`;
      }

      // Update counters
      updateQuizSummary();
      updateProgress();
    }

    function updateQuizSummary() {
      const totalAnswered = Object.keys(quizAnswers).length;
      const correctCount = Object.values(quizAnswers).filter(a => a.isCorrect).length;

      document.getElementById('score-badge').innerText = `Natija: ${correctCount} / 7`;
      document.getElementById('nav-quiz-badge').innerText = `${totalAnswered}/7`;

      if (totalAnswered === QUIZ_DATA.length) {
        const certBox = document.getElementById('cert-box');
        const scoreText = document.getElementById('cert-score-text');
        const gradeText = document.getElementById('cert-grade-text');

        certBox.style.display = 'block';
        const percent = Math.round((correctCount / QUIZ_DATA.length) * 100);
        let gradeStr = "5 (A'lo)";
        let gradeColor = "#4ade80";

        if (percent >= 86) {
          gradeStr = "5 (A'lo)";
          gradeColor = "#4ade80";
        } else if (percent >= 71) {
          gradeStr = "4 (Yaxshi)";
          gradeColor = "#60a5fa";
        } else if (percent >= 55) {
          gradeStr = "3 (Qoniqarli)";
          gradeColor = "#fde047";
        } else {
          gradeStr = "2 (Qoniqarsiz)";
          gradeColor = "#f87171";
        }

        scoreText.innerText = `To'plangan Ball: ${correctCount} / ${QUIZ_DATA.length} (${percent}%)`;
        gradeText.innerText = `Baho: ${gradeStr}`;
        gradeText.style.color = gradeColor;

        certBox.scrollIntoView({ behavior: 'smooth' });
      }
    }

    function resetQuiz() {
      for (let i = 1; i <= QUIZ_DATA.length; i++) {
        delete quizAnswers[i];
        const card = document.getElementById('q-card-' + i);
        if (card) {
          card.classList.remove('answered-correct', 'answered-incorrect');
          card.querySelectorAll('.quiz-option').forEach(opt => {
            opt.classList.remove('correct', 'incorrect', 'dimmed', 'disabled');
          });
          const exp = document.getElementById('exp-' + i);
          if (exp) exp.style.display = 'none';
        }
      }

      document.getElementById('cert-box').style.display = 'none';
      document.getElementById('score-badge').innerText = `Natija: 0 / 7`;
      document.getElementById('nav-quiz-badge').innerText = `0/7`;
      updateProgress();
    }

    // Dynamic Overall Lesson Progress
    function updateProgress() {
      const answeredCount = Object.keys(quizAnswers).length;
      let progress = 25;
      let desc = "Siz hozir kirish bo'limini o'rganmoqdasiz.";

      if (activeTab === 'intro') {
        progress = 25;
        desc = "Siz hozir kirish va IT ning 4 ta ustunini o'rganmoqdasiz.";
      } else if (activeTab === 'theory') {
        progress = 50;
        desc = "Siz nazariy tushunchalar va axborotning 7 ta shaklini o'rganmoqdasiz.";
      } else if (activeTab === 'practice') {
        progress = 75;
        desc = "Siz klaviatura, sichqoncha va virtual hamshira ish stolida amaliyot o'tayapsiz.";
      } else if (activeTab === 'quiz') {
        progress = Math.min(100, Math.round(75 + (answeredCount / QUIZ_DATA.length) * 25));
        desc = answeredCount === QUIZ_DATA.length 
          ? "Tabriklaymiz! Siz 1-darsni to'liq muvaffaqiyatli yakunladingiz." 
          : `Siz bilimni sinash testini topshirmoqdasiz (${answeredCount}/7 savol).`;
      }

      const bar = document.getElementById('progress-bar-fill');
      const text = document.getElementById('progress-percent');
      const descEl = document.getElementById('progress-status-desc');

      if (bar) bar.style.width = progress + '%';
      if (text) text.innerText = progress + '%';
      if (descEl) descEl.innerText = desc;
    }

    // Initialization on Page Load
    window.addEventListener('DOMContentLoaded', () => {
      updateUzbekDate();
      updateLEDs();
      updateProgress();
    });
  </script>
</body>
</html>
